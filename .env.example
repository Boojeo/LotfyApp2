# Capital.com issues SEPARATE API keys for the demo and live accounts.
# Generate each one in Settings -> API integrations while the platform is
# switched to that account.

# --- Demo (practice money) -------------------------------------------------
CAPITAL_DEMO_API_KEY=
CAPITAL_DEMO_IDENTIFIER=you@example.com
CAPITAL_DEMO_PASSWORD=
# Optional: a specific sub-account to switch to on connect.
CAPITAL_DEMO_ACCOUNT_ID=

# --- Live (real money) -----------------------------------------------------
# Leave blank until you have proven the bot on demo. Filling these in is not
# enough on its own -- live also needs broker.live_enabled: true in your
# config file, and --env live on the command line.
CAPITAL_LIVE_API_KEY=
CAPITAL_LIVE_IDENTIFIER=you@example.com
CAPITAL_LIVE_PASSWORD=
CAPITAL_LIVE_ACCOUNT_ID=

# --- Shared fallback -------------------------------------------------------
# If you only have one account, fill these instead and both environments will
# use them.
CAPITAL_API_KEY=
CAPITAL_IDENTIFIER=
CAPITAL_PASSWORD=

# --- MetaTrader 5 (Exness) -------------------------------------------------
# Only used when broker.platform is mt5 in config.yaml. These are exactly what
# you type into the MT5 login window. The password is the TRADING password of
# the MT5 account, not your Exness website password.
MT5_DEMO_LOGIN=
MT5_DEMO_PASSWORD=
MT5_DEMO_SERVER=
MT5_LIVE_LOGIN=
MT5_LIVE_PASSWORD=
MT5_LIVE_SERVER=
# Optional: only if more than one MetaTrader 5 is installed on this PC, the
# full path of the one to use, e.g. C:\Program Files\MetaTrader 5 EXNESS\terminal64.exe
MT5_DEMO_TERMINAL=
MT5_LIVE_TERMINAL=

# Optional: news provider for the fundamental section (marketaux or finnhub).
NEWS_API_KEY=

# Optional: enables the Claude synthesis of the news flow.
ANTHROPIC_API_KEY=

# --- Telegram --------------------------------------------------------------
# One bot is fine if you run one environment at a time.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# To run demo and live SIMULTANEOUSLY you need a separate bot for each.
# Two pollers sharing one token steal each other's updates, so commands would
# land in whichever process grabbed them first.
TELEGRAM_DEMO_BOT_TOKEN=
TELEGRAM_LIVE_BOT_TOKEN=
