# Capital.com API credentials.
# Generate the API key in Settings -> API integrations, and note that the demo
# and live accounts need separate keys.
CAPITAL_API_KEY=
CAPITAL_IDENTIFIER=you@example.com
CAPITAL_PASSWORD=
# Optional: switch to a specific sub-account on connect.
CAPITAL_ACCOUNT_ID=

# Optional: news provider for the fundamental section (marketaux or finnhub).
NEWS_API_KEY=

# Optional: enables the Claude synthesis of the news flow.
ANTHROPIC_API_KEY=

# Optional: enables Telegram alerts and commands.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
